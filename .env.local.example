# Local development database. Copy this file to `.env.local` when you want
# local runs and Drizzle commands to use Docker Postgres instead of the cloud DB.
DATABASE_URL=postgresql://chronostitch:chronostitch@localhost:55432/chronostitch_dev

# Keep these aligned with your real local secrets if auth/notifications are needed.
EAZO_PRIVATE_KEY=your_eazo_private_key_here
EAZO_APP_ID=your_eazo_app_id_here
CRON_SECRET=replace_with_a_long_random_string
